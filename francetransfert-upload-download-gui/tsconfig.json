/* To learn more about this file see: https://angular.dev/reference/configs/workspace-config */
{
  "compileOnSave": false,
  "compilerOptions": {
    // TypeScript 6 enables "strict" by default; this codebase was never strict.
    "strict": false,
    // "baseUrl" is deprecated in TS 6: map the absolute "src/..." imports explicitly.
    "paths": {
      "src/*": ["./src/*"]
    },
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "esModuleInterop": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "es2022",
    "lib": ["es2022", "dom"],
    "useDefineForClassFields": false
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictTemplates": true
  }
}
